# FACELESS MEDIA STUDIO - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# Studio Core Settings
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=true

# Monthly Spending Safeguard (Hard ceiling in INR)
MONTHLY_BUDGET_CEILING_INR=3000
DEFAULT_BUDGET_INR=0

# Default TTS Voice Engine: "edge_tts" (Free neural) or "pyttsx3" (Offline local)
DEFAULT_TTS_ENGINE=edge_tts
DEFAULT_VOICE_ID=en-US-ChristopherNeural

# YouTube Data API v3 & Google OAuth 2.0 Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secrets.json
YOUTUBE_TOKEN_FILE=config/token.json
YOUTUBE_CHANNEL_ID=

# Free Stock Media APIs (Optional)
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=
# Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional AI Text Generation (e.g. Gemini API / OpenAI API - Optional, Local rules default)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Voice API (ElevenLabs - Optional, Edge-TTS is free default)
ELEVENLABS_API_KEY=
